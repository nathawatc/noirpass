[Unit]
Description=noirpass Secret Service (GPG-backed org.freedesktop.secrets)
Documentation=https://specifications.freedesktop.org/secret-service-spec/latest/
# Do not start if another secret service (e.g. gnome-keyring) owns the name.
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/bin/noirpass
Restart=on-failure

# Hardening
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# Keep this at the XDG data parent, not the noirpass leaf: systemd resolves
# ReadWritePaths before ExecStart, while noirpass creates the leaf itself.
ReadWritePaths=%h/.local/share
PrivateTmp=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

[Install]
WantedBy=default.target
